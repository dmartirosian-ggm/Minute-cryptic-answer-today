---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const { title, description, canonicalPath, schema, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://minutecrypticanswertoday.com');
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Minute Cryptic Answer Today" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">
          <span class="brand-tiles" aria-hidden="true"><span>M</span><span>C</span></span>
          <span class="brand-name">Minute Cryptic Answer Today</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href="/">Today</a>
          <a href="/archive/">Archive</a>
          <a href="/how-to-solve-minute-cryptic/">How to solve</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          This is an unofficial fan site with daily hints and answers. It is not affiliated with or endorsed by
          Minute Cryptic. Play the puzzle at <a href="https://www.minutecryptic.com/" rel="nofollow noopener" target="_blank">minutecryptic.com</a>.
        </p>
        <p class="footer-links">
          <a href="/about/">About</a> · <a href="/privacy/">Privacy</a> · <a href="/archive/">Archive</a> · © {year}
        </p>
      </div>
    </footer>
  </body>
</html>
